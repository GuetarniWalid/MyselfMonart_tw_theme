<!DOCTYPE html>{% comment %}
  La page panier « B · Les tuiles » (ticket 14 de .scratch/collection-design), en construction : son modèle de test,
  templates/cart.refonte.json (/cart?view=refonte), n'a que sa section, sections/panier-page.liquid, qui écrit
  data-panier-page. Ce gabarit le lit dans la page rendue, comme layout/collection.liquid lit la marque de la nouvelle
  page collection : <html> porte alors data-refonte-page, et <head> charge la feuille de la nouvelle page collection
  (assets/collection-refonte.css : le bandeau pêche, le pied de page menthe, Albert Sans dans la page) et sa police.
  Les deux sections d'aujourd'hui (page-cart-items, page-cart-subtotal) ne sont plus rendues : la section de la page les
  remplace. Le repère est la section, jamais le nom du modèle : la bascule sera un échange de modèle.
  Toute autre page panier rend exactement le même HTML qu'avant (scripts/panier.test.cjs) : chaque condition tient sur
  sa ligne, sans contrôle des blancs (Shopify ne les retire pas comme liquidjs).
{% endcomment %}{% assign panier_page = false %}{% if content_for_layout contains ' data-panier-page>' %}{% assign panier_page = true %}{% endif %}
<html lang="{{ request.locale.iso_code }}"{% if panier_page %} data-refonte-page{% endif %}>
  <head>
    {% render 'head-base' %}{% if panier_page %}
    {{ 'collection-refonte.css' | asset_url | stylesheet_tag: preload: true }}{% endif %}
    {{ content_for_header }}{% if panier_page %}
    {% render 'collection-refonte-police' %}{% if template.suffix contains 'refonte' %}
    {% render 'collection-refonte-essai' %}{% endif %}{% endif %}
  </head>

  <body class="w-screen overflow-x-hidden text-main bg-secondary transition-colors duration-500 z-10 scrollbar relative min-h-screen">
    <a class="sr-only focus:not-sr-only" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% section 'tw-announcement-bar' %}
    {% section 'tw-header' %}

    <div id="wrapper-overlay" class="relative">
      <main id="MainContent" role="main">
        {% unless panier_page %}{% section 'page-cart-items' %}
        {% section 'page-cart-subtotal' %}
        {% endunless %}{{ content_for_layout }}
      </main>
      {% section 'tw-footer' %}
      <div id="overlay-content" class="absolute z-30 inset-0 bg-[rgba(0,46,93,0)] shadow-[shadow-[0_8px_32px_0_rgba(31,38,135,0.37)]] backdrop-blur-[2px] hidden"></div>
    </div>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };
      
      window.cartStrings = {
        error: `{{ 'general.cart.cart_error' | t }}`,
        quantityError: `{{ 'general.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };
      
      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
      };
      
      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
      };
    </script>

    {%- if settings.enable_cookie -%}
      {% render 'cookie-banner' %}
    {%- endif -%}
  </body>
</html>