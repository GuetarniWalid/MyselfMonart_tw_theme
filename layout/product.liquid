{%- comment -%}
  Page galerie des œuvres 3D (réglage « Page galerie » du bloc principal, qui pose data-galerie sur
  <main-product-blocks>, sections/main-product.liquid) : la page le sait dès le serveur. <html> porte
  data-galerie-page et la feuille de la page (assets/oeuvre-galerie.css) se charge ici, dans <head> : le bandeau,
  la pilule et le pied de page ont leurs couleurs dès le premier affichage, et la feuille n'a pas à guetter le
  bloc principal (:root:has(…), qui faisait refaire les styles de toute la page à chaque changement). Le
  repère est le réglage, lu dans la page rendue, jamais le nom du modèle : la bascule finale n'y change rien.
  Toute autre page rend exactement le même HTML qu'avant (scripts/oeuvre-galerie.test.cjs).
{%- endcomment -%}
{%- liquid
  assign galerie_page = false
  if content_for_layout contains ' data-galerie>'
    assign galerie_page = true
  endif
-%}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}"{% if galerie_page %} data-galerie-page{% endif %}>
  <head>
    {% render 'head-base' %}
    {{ content_for_header }}{% if galerie_page %}
    {{ 'oeuvre-galerie.css' | asset_url | stylesheet_tag }}{% endif %}

    <script src="{{ 'layout-product.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="w-screen overflow-x-hidden text-main bg-secondary transition-colors duration-500 z-10 scrollbar relative min-h-screen">
    <a class="sr-only focus:not-sr-only" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% section 'tw-announcement-bar' %}
    {% section 'tw-header' %}
    {% section 'tw-cart-drawer' %}
    {% render 'open-cart-drawer-button' %}


    <div id="wrapper-overlay" class="relative">
      <main id="MainContent" role="main">
        {{ content_for_layout }}
      </main>
      {% section 'tw-footer' %}
      <div id="overlay-content" class="absolute z-30 inset-0 bg-[rgba(0,46,93,0)] shadow-[shadow-[0_8px_32px_0_rgba(31,38,135,0.37)]] backdrop-blur-[2px] hidden"></div>
    </div>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };
      
      window.cartStrings = {
        error: `{{ 'general.cart.cart_error' | t }}`,
        quantityError: `{{ 'general.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };
      
      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
      };
      
      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
      };

      window.productPriceModel = '{{ product.price | money }}';
    </script>

    {%- comment -%}
      Encart promo « bon de 15 € » — fiche produit UNIQUEMENT.
      ⛔ Ce layout, pas layout/theme.liquid : les fiches produit rendent product.liquid.
    {%- endcomment -%}
    {%- if settings.enable_promo_popup -%}
      {% render 'promo-popup' %}
    {%- endif -%}

    {%- if settings.enable_cookie -%}
      {% render 'cookie-banner' %}
    {%- endif -%}
  </body>
</html>