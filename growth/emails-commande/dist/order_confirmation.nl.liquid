<span style="display:none;font-size:1px;color:#f6f2ec;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</span>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="bg" bgcolor="#f6f2ec" style="background-color:#f6f2ec;">
<tr><td align="center" class="outer" style="padding:0 12px;">
<!--[if mso]><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" align="center"><tr><td><![endif]-->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;max-width:600px;margin:0 auto;">
<tr><td align="center" class="px logo" style="padding:36px 44px 30px;font-family:'Avenir Next',Avenir,'Century Gothic','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:30px;color:#21150c;font-weight:normal;mso-line-height-rule:exactly;">
<a href="{{ shop.url }}" style="display:inline-block;color:#21150c;text-decoration:none;">
<img class="logoLight" src="https://cdn.shopify.com/s/files/1/0623/2388/4287/files/mail-logo-clair.png" width="230" height="37" alt="MyselfMonArt" style="display:block;width:230px;max-width:100%;height:auto;border:0;">
<img class="logoDark" src="https://cdn.shopify.com/s/files/1/0623/2388/4287/files/mail-logo-sombre.png" width="230" height="37" alt="" style="display:none;width:230px;max-width:100%;height:auto;border:0;mso-hide:all;">
</a>
</td></tr>
<tr><td class="px" style="padding:0 44px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td width="25%" class="barOn" style="border-top:2px solid #a0502f;font-size:0;line-height:0;">&nbsp;</td><td width="6" style="font-size:0;line-height:0;">&nbsp;</td><td width="25%" class="barOff" style="border-top:2px solid #ddd5ca;font-size:0;line-height:0;">&nbsp;</td><td width="6" style="font-size:0;line-height:0;">&nbsp;</td><td width="25%" class="barOff" style="border-top:2px solid #ddd5ca;font-size:0;line-height:0;">&nbsp;</td><td width="6" style="font-size:0;line-height:0;">&nbsp;</td><td width="25%" class="barOff" style="border-top:2px solid #ddd5ca;font-size:0;line-height:0;">&nbsp;</td></tr></table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr>
<td class="ink" style="padding-top:8px;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;color:#21150c;mso-line-height-rule:exactly;font-weight:bold;">Bevestiging</td>
<td align="right" class="sub" style="padding-top:8px;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;color:#6b5e55;mso-line-height-rule:exactly;">Stap 1 van 4</td>
</tr></table>
</td></tr>
<tr><td class="px acc" style="padding:40px 44px 0;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:16px;color:#a0502f;mso-line-height-rule:exactly;letter-spacing:1.5px;text-transform:uppercase;">Bestelling {{ order_name }}</td></tr>
<tr><td class="px" style="padding:12px 44px 0;">
<h1 class="h1 ink ff" style="margin:0;font-family:'Avenir Next',Avenir,'Century Gothic','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:29px;line-height:37px;color:#21150c;font-weight:600;mso-line-height-rule:exactly;">{% if art_count == 1 %}Een prachtige keuze{% elsif art_count > 1 %}Een prachtige selectie{% else %}Bedankt voor uw bestelling{% endif %}{% if first_name != blank %}, {{ first_name }}{% endif %}</h1>
</td></tr>
<tr><td class="px" style="padding:18px 44px 0;">
<p class="txt" style="margin:0 0 0;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:26px;color:#4a3f37;mso-line-height-rule:exactly;">Uw bestelling is geregistreerd. Elk werk wordt op bestelling gedrukt, speciaal voor u. U hoeft niets meer te doen: we schrijven u bij elke stap.</p>
</td></tr>
{%- if consolidated_estimated_delivery_time -%}
<tr><td class="px txt" style="padding:12px 44px 0;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#4a3f37;mso-line-height-rule:exactly;">Verwachte levering : <strong class="ink" style="color:#21150c;">{{ consolidated_estimated_delivery_time }}</strong></td></tr>
{%- endif -%}
{%- if delivery_instructions != blank -%}
<tr><td class="px txt" style="padding:12px 44px 0;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#4a3f37;mso-line-height-rule:exactly;">Uw bezorginstructies : {{ delivery_instructions }}</td></tr>
{%- endif -%}
<tr><td class="px" style="padding:0 44px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" class="btnw" style="border-collapse:separate;margin-top:28px;">
<tr><td align="center" class="btn" bgcolor="#21150c" style="background-color:#21150c;mso-padding-alt:16px 40px;">
<a href="{% if order_status_url %}{{ order_status_url }}{% else %}{{ shop.url }}/nl{% endif %}" style="display:block;padding:16px 40px;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:20px;font-weight:bold;letter-spacing:0.2px;color:#fffffe;text-decoration:none;mso-line-height-rule:exactly;">Mijn bestelling volgen</a>
</td></tr></table></td></tr>
{%- if art_count == 1 and hero -%}
{%- assign item_title = hero.product.title | default: hero.title -%}
{%- if hero.presentment_title != blank -%}{%- assign item_title = hero.presentment_title -%}{%- endif -%}
{%- assign oe_draw = false -%}
{%- assign oe_line_src = '' -%}
{%- if hero.image -%}{%- assign oe_line_src = hero | img_url: '160x160' -%}{%- endif -%}
{%- if hero.product.template_suffix == 'oeuvre-3d' or oe_line_src contains '/photo-studio-' -%}
{%- assign oe_has_src = false -%}
{%- if hero.product.featured_image != blank -%}{%- assign oe_src = hero.product.featured_image -%}{%- assign oe_has_src = true -%}
{%- else -%}{%- unless oe_line_src == '' or oe_line_src contains '/photo-studio-' -%}{%- assign oe_src = hero -%}{%- assign oe_has_src = true -%}{%- endunless -%}
{%- endif -%}
{%- assign oe_parts = hero.variant.title | default: hero.variant_title | split: ' / ' -%}
{%- assign oe_kind = '' -%}
{%- if oe_parts.size == 3 -%}{%- assign oe_kind = 'toile' -%}{%- elsif oe_parts.size == 2 -%}{%- assign oe_kind = 'poster' -%}{%- endif -%}
{%- if oe_kind != '' and oe_has_src -%}{%- assign oe_draw = true -%}{%- endif -%}
{%- endif -%}
{%- if oe_draw -%}
{%- assign oe_choice = oe_parts.last | downcase -%}
{%- assign oe_frame = 'sans' -%}
{%- assign oe_contour = false -%}
{%- if oe_kind == 'toile' -%}
{%- if oe_choice contains 'wit' or oe_choice contains 'blanc' -%}{%- assign oe_frame = 'blanc' -%}
{%- elsif oe_choice contains 'zwart' or oe_choice contains 'noir' -%}{%- assign oe_frame = 'noir' -%}
{%- elsif oe_choice contains 'zilver' or oe_choice contains 'argent' -%}{%- assign oe_frame = 'argent' -%}
{%- elsif oe_choice contains 'eik' or oe_choice contains 'chêne' or oe_choice contains 'chene' -%}{%- assign oe_frame = 'chene' -%}
{%- elsif oe_choice contains 'noten' or oe_choice contains 'noyer' -%}{%- assign oe_frame = 'noyer' -%}
{%- endif -%}
{%- else -%}
{%- assign oe_cadre = '' -%}
{%- for oe_property in hero.properties -%}
{%- if oe_property.first == '_cadre' -%}{%- assign oe_cadre = oe_property.last | downcase -%}{%- endif -%}
{%- if oe_property.first == '_passe_partout' and oe_property.last == 'oui' -%}{%- assign oe_contour = true -%}{%- endif -%}
{%- endfor -%}
{%- if oe_choice contains 'zonder' or oe_choice contains 'sans cadre' -%}
{%- elsif oe_cadre != blank -%}
{%- assign oe_frame = 'noir' -%}
{%- if oe_cadre contains 'blanc' -%}{%- assign oe_frame = 'blanc' -%}
{%- elsif oe_cadre contains 'argent' -%}{%- assign oe_frame = 'argent' -%}
{%- elsif oe_cadre contains 'chene' -%}{%- assign oe_frame = 'chene' -%}
{%- elsif oe_cadre contains 'noyer' -%}{%- assign oe_frame = 'noyer' -%}
{%- endif -%}
{%- elsif oe_choice contains 'met lijst' or oe_choice contains 'ingelijst' or oe_choice contains 'avec cadre' -%}{%- assign oe_frame = 'noir' -%}
{%- endif -%}
{%- endif -%}
{%- assign oe_caisse = false -%}{%- assign oe_verre = false -%}
{%- if oe_frame != 'sans' -%}{%- if oe_kind == 'toile' -%}{%- assign oe_caisse = true -%}{%- else -%}{%- assign oe_verre = true -%}{%- endif -%}{%- endif -%}
{%- case oe_frame -%}{%- when 'blanc' -%}{%- assign oe_c = '#efefed #fafafa #c9c9c7 #cccbc9 #e4e4e2 #a7a7a6' | split: ' ' -%}{%- when 'noir' -%}{%- assign oe_c = '#353535 #555555 #262626 #2f2f2e #333333 #252525' | split: ' ' -%}{%- when 'argent' -%}{%- assign oe_c = '#9a9381 #bab6a9 #787365 #847e6e #938c7b #6c675a' | split: ' ' -%}{%- when 'chene' -%}{%- assign oe_c = '#c2b09c #cdbeae #908273 #a69685 #b9a895 #887b6d' | split: ' ' -%}{%- when 'noyer' -%}{%- assign oe_c = '#856453 #9b8072 #624a3d #735647 #7f604f #5d463a' | split: ' ' -%}{%- endcase -%}
{%- if oe_kind == 'poster' -%}{%- case oe_frame -%}{%- when 'chene' -%}{%- assign oe_c = '#6f6765 #898281 #524c4b #605957 #6a6361 #4e4847' | split: ' ' -%}{%- when 'noyer' -%}{%- assign oe_c = '#766554 #8f8173 #574b3e #665748 #716150 #53473b' | split: ' ' -%}{%- endcase -%}{%- endif -%}
{%- if oe_caisse -%}{%- assign oe_wall = '#fffffe' -%}{%- assign oe_sh0 = 4 -%}{%- assign oe_s0 = '#f0efed' -%}{%- assign oe_sh1 = 3 -%}{%- assign oe_s1 = '#e1dfdd' -%}{%- assign oe_sh2 = 1 -%}{%- assign oe_s2 = '#bebbb7' -%}{%- elsif oe_verre -%}{%- assign oe_wall = '#f5f4f2' -%}{%- assign oe_sh0 = 3 -%}{%- assign oe_s0 = '#e9e7e5' -%}{%- assign oe_sh1 = 2 -%}{%- assign oe_s1 = '#dad8d5' -%}{%- assign oe_sh2 = 1 -%}{%- assign oe_s2 = '#bfbcb8' -%}{%- elsif oe_kind == 'toile' -%}{%- assign oe_wall = '#fffffe' -%}{%- assign oe_sh0 = 3 -%}{%- assign oe_s0 = '#f0efed' -%}{%- assign oe_sh1 = 2 -%}{%- assign oe_s1 = '#e1dfdd' -%}{%- assign oe_sh2 = 1 -%}{%- assign oe_s2 = '#c2bfbc' -%}{%- else -%}{%- assign oe_wall = '#f5f4f2' -%}{%- assign oe_sh0 = 2 -%}{%- assign oe_s0 = '#ebe9e7' -%}{%- assign oe_sh1 = 1 -%}{%- assign oe_s1 = '#dcdad7' -%}{%- assign oe_sh2 = 1 -%}{%- assign oe_s2 = '#c7c4c1' -%}{%- endif -%}
{%- assign oe_bord = 0 -%}
{%- if oe_caisse -%}{%- assign oe_bord = 18 -%}
{%- elsif oe_verre -%}{%- assign oe_bord = 11 -%}
{%- endif -%}
{%- if oe_verre -%}{%- assign oe_voile = '#e2e0dc' -%}{%- else -%}{%- assign oe_voile = '#efeeea' -%}{%- endif -%}
{%- assign oe_size = oe_parts.first | downcase | replace: '×', 'x' | remove: 'cm' | remove: ' ' | split: 'x' -%}
{%- assign oe_w = oe_size.first | plus: 0 -%}
{%- assign oe_h = oe_size.last | plus: 0 -%}
{%- assign oe_short = 1.0 -%}
{%- assign oe_landscape = true -%}
{%- if oe_w > 0 and oe_h > 0 -%}
{%- if oe_w < oe_h -%}{%- assign oe_short = oe_w | times: 1.0 | divided_by: oe_h -%}{%- assign oe_landscape = false -%}
{%- else -%}{%- assign oe_short = oe_h | times: 1.0 | divided_by: oe_w -%}
{%- endif -%}
{%- endif -%}
{%- assign oe_long = 300 | minus: oe_bord | minus: oe_bord | times: 1.0 -%}
{%- assign oe_m = 0 -%}
{%- if oe_contour -%}
{%- assign oe_grow = oe_short | times: 0.1904 | plus: 1 -%}
{%- assign oe_long = oe_long | divided_by: oe_grow -%}
{%- assign oe_m = oe_long | times: oe_short | times: 0.0952 | round -%}
{%- endif -%}
{%- assign oe_other = oe_long | times: oe_short | round -%}
{%- assign oe_long = oe_long | round -%}
{%- if oe_landscape -%}{%- assign oe_img = oe_long -%}{%- assign oe_img_h = oe_other -%}
{%- else -%}{%- assign oe_img = oe_other -%}{%- assign oe_img_h = oe_long -%}
{%- endif -%}
{%- endif -%}
<tr><td class="px" style="padding:40px 44px 0;">
