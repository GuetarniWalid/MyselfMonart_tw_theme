{%- endif %}
</td></tr>
</table>
</td></tr>
{%- endif -%}
{%- if one_line == false and art_count == 1 and hero -%}
{%- assign item_title = hero.product.title | default: hero.title -%}
{%- if hero.presentment_title != blank -%}{%- assign item_title = hero.presentment_title -%}{%- endif -%}
<tr><td class="px" style="padding:40px 44px 0;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td align="center" class="tile" bgcolor="#fffffe" style="background-color:#fffffe;padding:44px 28px;">
