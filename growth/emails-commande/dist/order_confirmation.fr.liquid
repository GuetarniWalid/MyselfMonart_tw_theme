<td valign="top" class="hair" style="padding:14px 0;border-top:1px solid #ddd5ca;">
<p class="ink ff" style="margin:0;word-break:break-word;font-family:'Avenir Next',Avenir,'Century Gothic','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:23px;color:#21150c;font-weight:normal;mso-line-height-rule:exactly;">{{ item_title }}</p>
<p class="sub" style="margin:2px 0 0;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;color:#6b5e55;mso-line-height-rule:exactly;">
{%- if line.variant.title != blank and line.variant.title != 'Default Title' %}{{ line.variant.title }}{%- endif -%}
