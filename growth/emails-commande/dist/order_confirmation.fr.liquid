<p class="acc" style="margin:2px 0 0;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;color:#a0502f;mso-line-height-rule:exactly;">{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</p>
