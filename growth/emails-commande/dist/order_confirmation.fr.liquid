{%- endif -%}
<tr><td class="px" style="padding:40px 44px 0;">
<p class="sub" style="margin:0 0 8px;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:16px;color:#6b5e55;mso-line-height-rule:exactly;letter-spacing:1.5px;text-transform:uppercase;">Votre commande</p>
{%- unless one_line %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
{%- for line in subtotal_line_items -%}
{%- assign item_title = line.product.title | default: line.title -%}
{%- if line.presentment_title != blank -%}{%- assign item_title = line.presentment_title -%}{%- endif -%}
<tr>
{%- if art_count == 1 and hero %}

