<p class="sub" style="margin:2px 0 0;font-family:Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;color:#6b5e55;mso-line-height-rule:exactly;">
{%- if line.variant.title != blank and line.variant.title != 'Default Title' %}{{ line.variant.title }}{%- endif -%}
{%- if line.quantity > 1 %}{%- if line.variant.title != blank and line.variant.title != 'Default Title' %} &nbsp;·&nbsp; {% endif %}Quantité : {{ line.quantity }}{%- endif %}
</p>
{%- else %}
<td width="76" valign="top" class="hair thumb" style="width:76px;padding:14px 16px 14px 0;border-top:1px solid #ddd5ca;">
