{%- assign first_name = customer.first_name | strip -%}
{%- assign first_name_caps = first_name | upcase -%}
{%- if first_name != blank and first_name == first_name_caps -%}{%- assign first_name = first_name | downcase | capitalize -%}{%- endif -%}
{%- assign art_count = 0 -%}
{%- assign hero = nil -%}
{%- for fl in fulfillment.fulfillment_line_items -%}
{%- assign line_format = fl.line_item.variant.title | append: ' ' | append: fl.line_item.variant_title | append: ' ' | append: fl.line_item.title -%}
{%- if line_format contains ' cm' -%}
{%- assign art_count = art_count | plus: fl.quantity -%}
{%- if hero == nil and fl.line_item.image -%}{%- assign hero = fl.line_item -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- capture email_title %}{% if art_count == 1 %}Su obra llega pronto{% elsif art_count > 1 %}Sus obras llegan pronto{% else %}Su pedido llega pronto{% endif %}{% endcapture -%}
