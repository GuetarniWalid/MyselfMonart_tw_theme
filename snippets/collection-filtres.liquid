{%- comment -%}
  La ligne des filtres de la nouvelle page collection (vue ?view=refonte, dossier .scratch/collection-design,
  ticket 06 ; décision 6 de Walid), rendue par sections/collection-grille.liquid juste au-dessus des tableaux, à la
  place #barre ; puis, dessous, les filtres actifs (#resume).
  - Partout les mêmes trois familles, Couleur, Format et Thème (les filtres « liste » de Search & Discovery, reconnus à
    leur paramètre : …color, …layout, …theme), puis le nombre de tableaux et le tri : en tête celui de la collection
    (« Pertinence » pour toutes depuis le 24/11/2026), puis Nouveautés et Meilleures ventes, jamais les prix (Walid).
    Chaque famille : snippets/collection-filtres-famille.liquid.
  - Ordinateur (900 px et plus) : chaque famille ouvre son menu ; un clic sur une valeur change la grille derrière.
    Téléphone : chaque famille ouvre son panneau posé en bas, le <dialog> #feuille, qui ne change la grille qu'au
    bouton « Voir les N tableaux ». Pas de bouton qui ouvre tous les filtres d'un coup.
  - Un formulaire GET : sans script, cocher puis valider marche encore.
  - Les filtres actifs : seulement s'il y en a (ou, sur téléphone, un tri autre que celui de la collection) ; chacun est un
    lien qui le retire (snippets/collection-filtres-pastille.liquid), puis « Tout effacer ».
  - La ligne porte ce que le script relit dans chaque réponse du serveur : le nombre de tableaux (data-total) et la
    phrase de la zone parlée (data-annonce : « 103 tableaux. Filtres : Bleu. »).
  Le tri neutre est celui de la collection (Walid, 24/11/2026 : « toujours le choix par défaut de Shopify, par
  pertinence ») : tout autre tri se montre. Il ne s'écrit pas dans l'adresse (data-tri-defaut, lu par le script).
  Le script : assets/collection-filtres.js (<collection-filtres>). Les textes : sections.mma.collection_filtres. Les
  styles : assets/collection-refonte.css, bloc « Ligne des filtres (ticket 06) ». Tests :
  scripts/collection-filtres.test.cjs.

  Paramètre : section_id, l'identifiant de la section qui rend la ligne (le script la redemande au serveur).
{%- endcomment -%}
{%- liquid
  # Les mots des œuvres (ticket 09) : « posters » sur une collection de posters (custom.type_of_collection), « tableaux »
  # ailleurs. Les textes des posters sont sous collection_filtres.poster, aux mêmes clés que ceux des tableaux :
  # cles_textes est le début de leurs clés.
  assign cles_textes = 'sections.mma.collection_filtres.'
  if collection.metafields.custom.type_of_collection == 'poster'
    assign cles_textes = 'sections.mma.collection_filtres.poster.'
  endif

  # Les trois familles, quel que soit l'ordre de Search & Discovery.
  assign filtre_couleur = nil
  assign filtre_format = nil
  assign filtre_theme = nil
  for filtre in collection.filters
    if filtre.type != 'list'
      continue
    endif
    if filtre.param_name contains 'color'
      unless filtre_couleur
        assign filtre_couleur = filtre
      endunless
    elsif filtre.param_name contains 'layout'
      unless filtre_format
        assign filtre_format = filtre
      endunless
    elsif filtre.param_name contains 'theme'
      unless filtre_theme
        assign filtre_theme = filtre
      endunless
    endif
  endfor

  # Les noms cochés de chaque famille, séparés par « ¤ » : le libellé court d'une couleur, un thème en double une fois.
  capture coches_couleur
    for valeur in filtre_couleur.active_values
      echo '¤'
      render 'filter-color-label', label: valeur.label, court: true
    endfor
  endcapture
  assign coches_couleur = coches_couleur | remove_first: '¤'
  assign coches_format = filtre_format.active_values | map: 'label' | join: '¤'
  assign coches_theme = filtre_theme.active_values | map: 'label' | uniq | join: '¤'
  # Tous les noms cochés, pour la zone parlée : « Bleu, Portrait, Zen ».
  assign noms_coches = coches_couleur | append: '¤' | append: coches_format | append: '¤' | append: coches_theme | split: '¤'
  assign liste_coches = ''
  for nom in noms_coches
    if nom != ''
      assign liste_coches = liste_coches | append: ', ' | append: nom
    endif
  endfor
  assign liste_coches = liste_coches | remove_first: ', '

  # Le tri (Walid, 24/11/2026) : Pertinence, Nouveautés, Meilleures ventes, jamais les prix. En tête, le tri par défaut
  # de la collection : « Le plus pertinent » de Shopify (« Pertinence »), mis à toutes les collections ce jour-là, et
  # d'office à celles créées depuis avril 2026 ; si l'une en change dans l'admin, c'est ce tri qui vient en tête, sous
  # son nom. Le tri choisi est celui de l'adresse s'il est proposé, sinon celui de la collection ; seul un tri autre que
  # celui de la collection se montre (pastille, zone parlée).
  assign tri_defaut = collection.default_sort_by
  assign tris = tri_defaut | append: ',created-descending,best-selling' | split: ',' | uniq
  assign tris_proposes = collection.sort_options | map: 'value'
  assign tri = collection.sort_by | default: tri_defaut
  assign tri_affiche = tri_defaut
  if tris contains tri
    assign tri_affiche = tri
  endif
  assign cle_nom_tri = 'sections.mma.collection_filtres.tris.' | append: tri_affiche | replace: '-', '_'
  assign nom_tri = cle_nom_tri | t
  assign tri_perso = false
  if tri_affiche != tri_defaut
    assign tri_perso = true
  endif

  # La phrase de la zone parlée, après chaque changement.
  assign nombre_tableaux = collection.products_count
  assign annonce = cles_textes | append: 'annonce_tableaux' | t: count: nombre_tableaux
  if liste_coches != ''
    assign suite = 'sections.mma.collection_filtres.annonce_filtres' | t: liste: liste_coches
  else
    assign suite = 'sections.mma.collection_filtres.annonce_sans_filtre' | t
  endif
  assign annonce = annonce | append: ' ' | append: suite
  if tri_perso
    assign suite = 'sections.mma.collection_filtres.annonce_tri' | t: tri: nom_tri
    assign annonce = annonce | append: ' ' | append: suite
  endif

  # L'adresse des filtres seuls (sans le tri), pour la pastille qui retire le tri sans script.
  capture requete_filtres
    for filtre in collection.filters
      for valeur in filtre.active_values
        assign encodee = valeur.value | url_encode
        echo '&' | append: valeur.param_name | append: '=' | append: encodee
      endfor
    endfor
  endcapture
  assign requete_filtres = requete_filtres | remove_first: '&'
  assign adresse_sans_tri = collection.url
  if requete_filtres != ''
    assign adresse_sans_tri = adresse_sans_tri | append: '?' | append: requete_filtres
  endif
-%}
<collection-filtres id="barre" class="filtres-ligne" data-section="{{ section_id }}" data-total="{{ nombre_tableaux }}" data-tri-defaut="{{ collection.default_sort_by }}" data-annonce="{{ annonce }}">
  <form class="filtres-form" method="get" action="{{ collection.url }}" aria-label="{{ cles_textes | append: 'ligne' | t }}" autocomplete="off">
    <div class="filtres-dedans">
      <div class="filtres-defile">
        {%- if filtre_couleur -%}{%- render 'collection-filtres-famille', famille: 'couleur', filtre: filtre_couleur, coches: coches_couleur, nombre: nombre_tableaux, cles_textes: cles_textes -%}{%- endif -%}
        {%- if filtre_format -%}{%- render 'collection-filtres-famille', famille: 'format', filtre: filtre_format, coches: coches_format, nombre: nombre_tableaux, cles_textes: cles_textes -%}{%- endif -%}
        {%- if filtre_theme -%}{%- render 'collection-filtres-famille', famille: 'theme', filtre: filtre_theme, coches: coches_theme, nombre: nombre_tableaux, cles_textes: cles_textes -%}{%- endif -%}
        <p class="filtres-compte">{{ cles_textes | append: 'compte_html' | t: count: nombre_tableaux }}</p>
        <label class="filtres-tri"{% if tri_perso %} data-actif{% endif %}>
          <span class="filtres-tri-tel">{% if tri_perso %}{{ 'sections.mma.collection_filtres.tri_actif' | t: tri: nom_tri }}{% else %}{{ 'sections.mma.collection_filtres.trier' | t }}{% endif %}</span>
          <span class="filtres-tri-ordi">{{ 'sections.mma.collection_filtres.trier_par' | t }} <span class="filtres-tri-nom">{{ nom_tri }}</span></span>
          <select name="sort_by" aria-label="{{ cles_textes | append: 'trier_nom' | t }}">
            {%- for valeur_tri in tris -%}
              {%- comment -%} Le tri de la collection, toujours : collection.sort_options ne nomme pas « most-relevant ». {%- endcomment -%}
              {%- if tris_proposes contains valeur_tri or valeur_tri == tri_defaut -%}
                {%- assign cle_option = 'sections.mma.collection_filtres.tris.' | append: valeur_tri | replace: '-', '_' -%}
                <option value="{{ valeur_tri }}"{% if valeur_tri == tri_affiche %} selected{% endif %}>{{ cle_option | t }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
          {%- render 'collection-filtres-icone', nom: 'chevron' -%}
        </label>
        <noscript><button type="submit" class="filtres-appliquer">{{ 'sections.mma.collection_filtres.appliquer' | t }}</button></noscript>
      </div>
    </div>
    <dialog id="feuille" class="filtres-feuille" data-allow-empty></dialog>
  </form>
</collection-filtres>
<div id="resume" class="filtres-resume"{% if liste_coches == '' %}{% if tri_perso %} data-tri-seul{% else %} hidden{% endif %}{% endif %}>
  {%- if liste_coches != '' or tri_perso -%}
    <p class="filtres-resume-compte">{{ cles_textes | append: 'compte_html' | t: count: nombre_tableaux }}</p>
    {%- for valeur in filtre_couleur.active_values -%}
      {%- capture nom -%}{% render 'filter-color-label', label: valeur.label, court: true %}{%- endcapture -%}
      {%- render 'collection-filtres-pastille', famille: 'couleur', valeur: valeur, nom: nom -%}
    {%- endfor -%}
    {%- for valeur in filtre_format.active_values -%}
      {%- render 'collection-filtres-pastille', famille: 'format', valeur: valeur, nom: valeur.label -%}
    {%- endfor -%}
    {%- assign themes_coches = coches_theme | split: '¤' -%}
    {%- for nom in themes_coches -%}
      {%- comment -%} Un thème en double (deux valeurs) : une pastille, à la première de ses valeurs cochées. {%- endcomment -%}
      {%- assign valeur = filtre_theme.active_values | where: 'label', nom | first -%}
      {%- render 'collection-filtres-pastille', famille: 'theme', valeur: valeur, nom: nom -%}
    {%- endfor -%}
    {%- if tri_perso -%}
      <a class="filtres-pastille filtres-pastille-tri" href="{{ adresse_sans_tri }}" aria-label="{{ 'sections.mma.collection_filtres.tri_retirer' | t }}" data-retirer-tri>
        <span>{{ 'sections.mma.collection_filtres.tri_pastille' | t: tri: nom_tri }}</span>
        {%- render 'collection-filtres-icone', nom: 'croix' -%}
      </a>
    {%- endif -%}
    <a class="filtres-tout" href="{{ collection.url }}" data-tout>{{ 'sections.mma.collection_filtres.tout_effacer' | t }}</a>
  {%- endif -%}
</div>
<script src="{{ 'collection-filtres.js' | asset_url }}" defer></script>
