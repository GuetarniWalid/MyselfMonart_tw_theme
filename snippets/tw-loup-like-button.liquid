<ul class="flex items-center transition-colors duration-500 cursor-pointer">
    <li>
        <button id="open-search-loup" class="mobile-mini:p-2 p-4 transition-colors duration-500 flex justify-center items-center">
            <span class="translate-x-[3px] inline-block">{% render 'tw-icon-loup' %}</span>
        </button>
    </li>
    <li class="group relative">
        {% liquid
            comment
                ⛔ LE LIEN SUIT LE MARCHÉ, PAS LA LANGUE.
                request.locale.iso_code rend « en » aussi bien sur /en — qui est une vitrine du
                marché FRANCE, en euros — que sur /en-us. Construire « /<langue>/pages/… » jetait
                donc l'Américain et le Suisse sur la boutique française ; et le Canadien
                francophone tombait dans la branche « marché primaire » (sa langue EST la langue
                primaire), donc sur /pages/… sans préfixe, en euros lui aussi.
                routes.root_url porte le préfixe RÉEL du marché : « / » sur le marché primaire,
                « /en-us », « /fr-ca », « /de-ch » ailleurs. Vérifié sur les 4 marchés.
                ⚠️ Hors marché primaire il n'y a PAS de barre oblique finale, d'où le test
                explicite plutôt qu'un append direct qui donnerait « /en-uspages/ ».
            endcomment
            assign racine = routes.root_url
            if racine == "/"
                assign racine = ""
            endif
            assign likes_page = racine | append: "/pages/" | append: settings.likes_page | base64_encode
        %}
        <span tabindex="0" class="group obfuscate p-4 transition-colors duration-500 relative" data-url64="{{ likes_page }}">
            {% render 'tw-icon-heart-outline' %}
        </span>
        <likes-count>
            <span class="pointer-events-none select-none absolute flex justify-center items-center font-bold bg-secondary transition-colors duration-500 rounded-full h-4 w-4 top-0 right-3">0</span>
        </likes-count>
    </li>
</ul>

<script defer>
    class LikesCount extends HTMLElement {
        connectedCallback() {
            this.updateCount();
        }

        updateCount() {
            const productLikedIds = localStorage.getItem('productLikedIds');
            const productLikedIdsArr = JSON.parse(productLikedIds) || [];
            const count = productLikedIdsArr.length;
            this.likeCount = this.likeCount || this.querySelector('span');
            if(!this.likeCount) return;
            if(count > 0) {
                this.likeCount.textContent = count;
                this.likeCount.classList.remove('hidden');
            } else {
                this.likeCount.classList.add('hidden');
            }
        }
    }
    customElements.define('likes-count', LikesCount);
</script>