{%- comment -%}
  Le modèle d'un produit pour la scène 3D de la fiche (assets/component-oeuvre-3d.js, catalogOf) : ses
  vraies variantes, et ce qui en donne la matière, dans toutes les langues : les handles des métaobjets
  bordure et cadre de la toile, les couleurs de cadre du poster et son contour blanc (propriétés de
  ligne, comme dans snippets/painting-variant-picker.liquid). Rendu pour la fiche et pour son jumeau
  (métachamps link.poster / link.painting), dans un <script type="application/json">.

  Accepts:
  - product: {Object}
{%- endcomment -%}
{%- liquid
  assign is_poster = false
  if product.metafields.painting_options.frames_poster != blank
    assign is_poster = true
  endif
  assign has_passe_partout = false
  for m in product.media
    if m.media_type == 'image' and m.preview_image.src contains 'passe-partout'
      assign has_passe_partout = true
      break
    endif
  endfor
-%}
{
  "material": {% if is_poster %}"poster"{% else %}"toile"{% endif %},
  "url": {{ product.url | json }},
  {%- for option in product.options_with_values -%}
    {%- if option.position == 1 %}
  "sizes": [{%- for value in option.values -%}{{ value.name | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
    {%- elsif is_poster and option.position == 2 %}
  "frameModes": [{%- for value in option.values -%}{{ value.name | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
    {%- elsif option.position == 2 %}
  "borders": [
      {%- for value in option.values -%}
        {%- assign key = null -%}
        {%- for border in product.metafields.painting_options.borders.value -%}
          {%- if border.name == value.name -%}{%- assign key = border.system.handle -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        [{{ value.name | json }},{{ key | json }}]{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}],
    {%- elsif option.position == 3 %}
  "frames": [
      {%- for value in option.values -%}
        {%- assign key = null -%}
        {%- for frame in product.metafields.painting_options.frames_canvas.value -%}
          {%- if frame.name == value.name -%}{%- assign key = frame.system.handle -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        [{{ value.name | json }},{{ key | json }}]{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}],
    {%- endif -%}
  {%- endfor -%}
  {%- if is_poster %}
  "frameColors": [
    {%- for frame in product.metafields.painting_options.frames_poster.value -%}
      [{{ frame.name | json }},{{ frame.system.handle | json }}]{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}],
  "passe": {{ has_passe_partout }},
  {%- endif %}
  "variants": [
    {%- for variant in product.variants -%}
      [{{ variant.id }},{{ variant.option1 | json }},{{ variant.option2 | json }},{{ variant.option3 | json }},{{ variant.price }},{{ variant.available }}]{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}]
}
