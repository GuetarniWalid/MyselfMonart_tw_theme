{%- liquid
  # title_override / description_override are passed by head-base.liquid so the
  # homepage (and any future locale-driven page) keeps og/twitter in sync with
  # the localised <title> / <meta description>. Falls back to Shopify defaults.
  assign og_title = title_override | default: page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = description_override | default: page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  # og:locale must be a valid lang_REGION. request.locale.iso_code is usually a
  # bare language ('es','nl','de') — pairing it with the market country gave
  # invalid values like es_FR. Keep an explicit region per language; locales
  # that already carry a region (e.g. fr-CA) pass straight through.
  assign og_locale = request.locale.iso_code | replace: '-', '_'
  unless og_locale contains '_'
    case og_locale
      when 'fr'
        assign og_locale = 'fr_FR'
      when 'es'
        assign og_locale = 'es_ES'
      when 'nl'
        assign og_locale = 'nl_NL'
      when 'de'
        assign og_locale = 'de_DE'
      when 'en'
        assign og_locale = 'en_US'
    endcase
  endunless

  # og:image : l'image de la page (page_image ; sur une fiche, la 1re image du produit). Pour un nouveau produit,
  # sa photo studio si le serveur l'a faite (snippet artwork-studio-index) : l'œuvre seule au mur, l'image de
  # partage, avec sa taille. Tout autre produit et toute autre page gardent page_image, à l'octet près.
  assign og_image = page_image
  if request.page_type == 'product'
    capture studio_index
      render 'artwork-studio-index', product: product
    endcapture
    assign studio_index = studio_index | default: -1 | plus: 0
    if studio_index >= 0
      assign og_image = product.media[studio_index].preview_image
    endif
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:locale" content="{{ og_locale }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image -%}
  <meta property="og:image" content="http:{{ og_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url }}">
  <meta property="og:image:width" content="{{ og_image.width }}">
  <meta property="og:image:height" content="{{ og_image.height }}">
  <meta property="og:image:alt" content="{{ og_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- comment -%} Sur une URL ?variant=X, le prix de X (celui affiché et celui du JSON-LD) ; sinon le prix « à partir de ». {%- endcomment -%}
  {%- assign og_price = product.price -%}
  {%- if product.selected_variant -%}
    {%- assign og_price = product.selected_variant.price -%}
  {%- endif -%}
  <meta property="og:price:amount" content="{{ og_price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
