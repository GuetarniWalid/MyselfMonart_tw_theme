{% comment %}
  Scène de la fiche d'œuvre (fiche-3d, ticket 07) : remplace la galerie quand le modèle de page le
  demande (réglage media_display de sections/main-product.liquid).

  La vraie image (media[1], l'œuvre à plat) s'affiche d'abord, au pixel près là où la 3D posera la
  façade du tableau : 72 % du plus petit côté de la scène, comme le plan de face du moteur. Le fondu
  ne décale donc rien. Elle reste dans la page, pour Google Images et pour le retour aux photos. Le
  comportement est dans assets/component-oeuvre-3d.js, le moteur dans assets/oeuvre-3d-engine.js.

  Les couleurs de la scène sont celles du mur réglé au prototype (neutralRoom du moteur), pas des
  couleurs de marque : un mur doit rester un mur.

  Sur téléphone, la scène reste en haut de l'écran pendant qu'on parcourt les options, et se place
  sous l'en-tête quand il revient (assets/tw-header.js). Sur ordinateur, elle reste fixe à gauche.
  z-[25] : au-dessus de ce qui défile dessous (étoiles et flèches des options en z-10, cœur en z-20), sous
  le bouton du panier (z-30) et l'en-tête (z-40). La barre d'achat, en bas de l'écran, ne la croise pas.

  Accepts:
  - product: {Object}
  - start_from: {Number} première image des photos de repli, comme la galerie (start_from_media)
{% endcomment %}

{%- liquid
  assign art_media = product.media[1]
  assign art = art_media.preview_image
  assign alts = product.metafields.meta_object.media.value.alts.value
  assign art_alt = alts[1] | default: art_media.alt
  assign tool_class = 'rounded-full border border-main-20 bg-secondary px-3 py-[7px] text-[13px] font-medium text-main shadow-sm transition-colors duration-150 hover:bg-main-5 motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-main focus-visible:ring-offset-2'
-%}
<script src="{{ 'component-oeuvre-3d.js' | asset_url }}" defer="defer"></script>
<oeuvre-3d
  class="sticky top-0 z-[25] block transition-[top] duration-150 motion-reduce:transition-none [body:has(header.translate-y-0)_&]:top-[var(--header-h)] 2md:col-start-1 2md:row-span-2 2md:row-start-1 2md:top-4 2md:my-4 2md:self-start 2md:[body:has(header.translate-y-0)_&]:top-[calc(var(--header-h)+1rem)]"
  data-state="arrival">
  <script type="application/json" data-config>
    {
      "three": {{ 'three.module.min.js' | asset_url | json }},
      "engine": {{ 'oeuvre-3d-engine.js' | asset_url | json }},
      "wood": {{ 'texture-chene-clair-cadre.jpg' | asset_url | json }},
      "detail": {{ art | image_url: width: 2000 | json }}
    }
  </script>
  <figure
    data-stage
    class="relative m-0 h-[min(56vh,128vw)] overflow-hidden bg-[radial-gradient(70%_60%_at_40%_38%,#efefee_0%,#e9e9e8_55%,#dcdcdb_100%)] [container-type:size] supports-[height:1svh]:h-[min(56svh,128vw)] 2md:h-[calc(100vh-13rem)] 2md:min-h-[26rem] 2md:rounded-2xl supports-[height:1svh]:2md:h-[calc(100vh-13rem)]"
    style="--art-ratio: {{ art.aspect_ratio }}">
    {%- comment -%} crossorigin : cette image sert aussi de texture, sans second téléchargement. {%- endcomment -%}
    <img
      data-art
      class="absolute left-1/2 top-1/2 h-auto max-h-[72%] max-w-[72%] -translate-x-1/2 -translate-y-1/2 w-[min(72cqw,calc(72cqh*var(--art-ratio)))] shadow-[0.5cqh_0.6cqh_1.2cqh_rgba(40,32,24,0.13),0_0_0.4cqh_rgba(40,32,24,0.1)] transition-opacity duration-300"
      src="{{ art | image_url: width: 750 }}"
      srcset="{%- if art.width >= 400 -%}{{ art | image_url: width: 400 }} 400w,{%- endif -%}
        {%- if art.width >= 550 -%}{{ art | image_url: width: 550 }} 550w,{%- endif -%}
        {%- if art.width >= 750 -%}{{ art | image_url: width: 750 }} 750w,{%- endif -%}
        {%- if art.width >= 1100 -%}{{ art | image_url: width: 1100 }} 1100w,{%- endif -%}
        {%- if art.width >= 1500 -%}{{ art | image_url: width: 1500 }} 1500w,{%- endif -%}
        {{ art | image_url }} {{ art.width }}w"
      sizes="(min-width: 900px) 34vw, 66vw"
      alt="{{ art_alt | escape }}"
      width="{{ art.width }}"
      height="{{ art.height }}"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      crossorigin="anonymous"
      data-media-id="{{ art_media.id }}">
    {%- comment -%} touch-action : un doigt vertical fait défiler la page, un doigt de côté incline le tableau. {%- endcomment -%}
    <canvas
      data-gl
      class="absolute inset-0 h-full w-full cursor-grab touch-pan-y opacity-0 transition-opacity duration-[450ms] active:cursor-grabbing motion-reduce:transition-none"
      role="img"
      aria-label="{{ 'sections.mma.perspective_preview_of' | t: title: product.title }}"
      aria-hidden="true">{{ 'sections.mma.perspective_canvas_caption' | t: title: product.title }}</canvas>
    <div data-dims class="pointer-events-none absolute inset-0 text-main opacity-0" aria-hidden="true">
      <div data-dim-width class="absolute h-0 border-t border-current font-roboto text-[12px] font-medium before:absolute before:-top-[5px] before:left-0 before:h-[9px] before:w-px before:bg-current after:absolute after:-top-[5px] after:right-0 after:h-[9px] after:w-px after:bg-current"><span class="absolute left-1/2 -translate-x-1/2 -translate-y-[125%] whitespace-nowrap rounded bg-secondary px-1.5 py-px"></span></div>
      <div data-dim-height class="absolute w-0 border-l border-current font-roboto text-[12px] font-medium before:absolute before:-left-[5px] before:top-0 before:h-px before:w-[9px] before:bg-current after:absolute after:-left-[5px] after:bottom-0 after:h-px after:w-[9px] after:bg-current"><span class="absolute top-1/2 translate-x-2 -translate-y-1/2 whitespace-nowrap rounded bg-secondary px-1.5 py-px"></span></div>
    </div>
    <p data-hint class="pointer-events-none absolute left-1/2 top-3 m-0 hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-secondary px-2.5 py-[3px] text-[12px] font-medium text-main-80 transition-opacity duration-300 motion-reduce:transition-none">{{ 'sections.mma.oeuvre_3d_hint' | t }}</p>
    <div data-tools class="absolute bottom-2.5 right-4 flex hidden gap-2">
      <button type="button" data-back class="{{ tool_class }}">{{ 'sections.mma.oeuvre_3d_back' | t }}</button>
      <button type="button" data-front class="{{ tool_class }}">{{ 'sections.mma.oeuvre_3d_front' | t }}</button>
    </div>
    {%- comment -%} Sans 3D : les autres photos, chargées seulement si on les demande, et les mêmes que la
       galerie : à partir de start_from, ni l'image à plat, ni les contours blancs. Même navigation que le
       carrousel de la fiche. Le fondu reste en animations réduites : c'est la décision 5, et la seule
       transition de ce mode, d'où l'absence de motion-reduce sur ces images et sur la première. {%- endcomment -%}
    <template data-photos>
      {%- assign image_index = 0 -%}
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          {%- assign image_index = image_index | plus: 1 -%}
          {%- if image_index >= start_from and image_index != 2 -%}
            {%- unless media.preview_image.src contains 'passe-partout' -%}
              {%- assign photo_alt = alts[forloop.index0] | default: media.alt -%}
              <img
                class="absolute inset-0 h-full w-full object-contain opacity-0 transition-opacity duration-300"
                src="{{ media.preview_image | image_url: width: 1100 }}"
                srcset="{%- if media.preview_image.width >= 550 -%}{{ media.preview_image | image_url: width: 550 }} 550w,{%- endif -%}
                  {%- if media.preview_image.width >= 1100 -%}{{ media.preview_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                  {{ media.preview_image | image_url }} {{ media.preview_image.width }}w"
                sizes="(min-width: 900px) 60vw, 100vw"
                alt="{{ photo_alt | escape }}"
                width="{{ media.preview_image.width }}"
                height="{{ media.preview_image.height }}"
                loading="eager"
                decoding="async">
            {%- endunless -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </template>
    <div data-photo-nav class="absolute bottom-3 left-1/2 flex hidden h-[47px] -translate-x-1/2 items-center justify-center overflow-hidden rounded-full border-1 border-main bg-secondary">
      <button type="button" data-previous class="h-full pl-5 pr-3 hover:bg-main-10 focus-visible:bg-main-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-main" aria-label="{{ 'sections.mma.oeuvre_3d_photo_previous' | t }}">
        <span class="block rotate-90">{% render 'tw-icon-caret', width: '18' %}</span>
      </button>
      <span data-photo-count class="px-3"></span>
      <button type="button" data-next class="h-full pl-3 pr-5 hover:bg-main-10 focus-visible:bg-main-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-main" aria-label="{{ 'sections.mma.oeuvre_3d_photo_next' | t }}">
        <span class="block -rotate-90">{% render 'tw-icon-caret', width: '18' %}</span>
      </button>
    </div>
    <figcaption class="sr-only">{{ 'sections.mma.perspective_figcaption' | t: title: product.title }}</figcaption>
    <noscript>
      <p class="sr-only">{{ 'sections.mma.perspective_noscript' | t: title: product.title }}</p>
    </noscript>
  </figure>
</oeuvre-3d>
