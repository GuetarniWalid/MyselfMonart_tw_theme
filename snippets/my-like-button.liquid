{% comment %}
  Renders a like button for a product.
  Accepts:
  - product: {Object}
  - margin_bottom: {String}
  - dessin: {String} 'papiers' : le cœur de papiers du nouveau design (snippets/coeur-papiers.liquid) ; sinon, celui de
    toujours

  Usage:
  {% render 'my-like-button', product: product %}
{% endcomment %}

<my-like-button data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}">
  <button type="button" aria-label="{{ 'sections.mma.add_artwork_to_favorites' | t }}" class="inline-flex flex-col like relative p-2 items-center gap-1 z-20 {{ margin_bottom }}">
    {% if dessin == 'papiers' %}{% render 'coeur-papiers' %}{% else %}{% render 'tw-icon-heart-design' %}{% endif %}
  </button>
</my-like-button>