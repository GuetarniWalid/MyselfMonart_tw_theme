{% comment %}
  Le fil d'Ariane de la fiche 3D (modèle product.oeuvre-3d) : la capsule de la maquette 7a « Menu : le
  chevron ouvre tout le chemin » (Claude Design, Fiche chips v2), validée par Walid le 15/11/2026.
  Posée sur le mur de la scène, en haut à gauche (règles .oeuvre-3d-crumb* d'input.css) : le nom du
  parent, qui y ramène, son chevron couché devant ; après un filet, un chevron ouvre le chemin entier,
  de l'accueil à l'œuvre, sur une plaque de verre. Un fil vertical relie les niveaux, un point
  terracotta marque la page en cours. Ouvrir, refermer : assets/component-oeuvre-3d-crumb.js.
  Le chemin est celui de sections/breadcrumb.liquid, qui rend ce snippet avec sa liste JSON-LD : tous
  les liens restent dans la page, même repliés (référencement).
  Le chevron est tracé en deux branches qui partent de sa pointe : celui qui ouvre le chemin les replie
  en tiret tant que le chemin est ouvert (input.css, 15/11/2026), comme ceux des légendes de la scène
  (assets/oeuvre-3d-chips.js). Le tiret seul ne sert qu'aux animations réduites, en fondu.

  Accepts:
  - names: {Array} les noms du chemin, de l'accueil à l'œuvre
  - urls: {Array} leurs adresses, dans le même ordre
  - current: {String} le nom de l'œuvre dans le chemin (son titre court)
{% endcomment %}
{%- liquid
  assign parent_index = names.size | minus: 2
  if parent_index < 0
    assign parent_index = 0
  endif
  assign parent_name = names[parent_index]
  assign parent_url = urls[parent_index]
-%}
{%- capture crumb_branches -%}
  <path class="oeuvre-3d-crumb-branch" d="M3.75 3.55.75 1.45" pathLength="1"/><path class="oeuvre-3d-crumb-branch" d="M3.75 3.55 6.75 1.45" pathLength="1"/>
{%- endcapture -%}
<script src="{{ 'component-oeuvre-3d-crumb.js' | asset_url }}" defer="defer"></script>
<oeuvre-3d-crumb class="oeuvre-3d-crumb">
  <div class="oeuvre-3d-crumb-closer" data-crumb-closer data-allow-empty aria-hidden="true"></div>
  <nav class="oeuvre-3d-crumb-nav" aria-label="{{ 'sections.mma.breadcrumb_nav' | t }}">
    <div class="oeuvre-3d-crumb-bar">
      <a class="oeuvre-3d-crumb-parent" href="{{ parent_url }}" aria-label="{{ 'sections.mma.breadcrumb_back_to' | t: name: parent_name }}">
        <svg class="oeuvre-3d-crumb-chevron" width="7.5" height="5" viewBox="0 0 7.5 5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" aria-hidden="true" focusable="false">{{ crumb_branches }}</svg>
        <span class="oeuvre-3d-crumb-name">{{ parent_name }}</span>
      </a>
      <span class="oeuvre-3d-crumb-rule" data-allow-empty aria-hidden="true"></span>
      <button
        type="button"
        class="oeuvre-3d-crumb-toggle"
        data-crumb-toggle
        aria-expanded="false"
        aria-controls="Oeuvre3dCrumbPath"
        aria-label="{{ 'sections.mma.breadcrumb_show_path' | t }}">
        <svg class="oeuvre-3d-crumb-chevron" width="7.5" height="5" viewBox="0 0 7.5 5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" aria-hidden="true" focusable="false">
          {{- crumb_branches -}}
          <path class="oeuvre-3d-crumb-dash" d="M1.375 2.5h4.75"/>
        </svg>
      </button>
    </div>
    <div class="oeuvre-3d-crumb-panel" id="Oeuvre3dCrumbPath">
      <span class="oeuvre-3d-crumb-thread" data-allow-empty aria-hidden="true"></span>
      <ol class="oeuvre-3d-crumb-path">
        {%- for name in names -%}
          <li style="--i: {{ forloop.index0 }}">
            {%- if forloop.last -%}
              <span class="oeuvre-3d-crumb-step" aria-current="page">
                <span class="oeuvre-3d-crumb-dot" data-allow-empty aria-hidden="true"></span>
                <span class="oeuvre-3d-crumb-label">{{ current }}</span>
              </span>
            {%- else -%}
              <a class="oeuvre-3d-crumb-step" href="{{ urls[forloop.index0] }}">
                <span class="oeuvre-3d-crumb-dot" data-allow-empty aria-hidden="true"></span>
                <span class="oeuvre-3d-crumb-label">{{ name }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </nav>
</oeuvre-3d-crumb>
